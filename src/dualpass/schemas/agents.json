{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dualpass agents config",
  "type": "object",
  "required": ["roles"],
  "additionalProperties": false,
  "properties": {
    "roles": {
      "type": "object",
      "required": ["author", "reviewer"],
      "additionalProperties": { "$ref": "#/$defs/role" },
      "properties": {
        "author": { "$ref": "#/$defs/role" },
        "reviewer": { "$ref": "#/$defs/role" },
        "reviewer_fallback": { "$ref": "#/$defs/role" }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "transient_retries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "transient_retry_delay_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "transient_retry_patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exhaustion_patterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "activate_after_consecutive_exhausted": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}

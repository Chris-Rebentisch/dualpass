{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dualpass stages config",
  "type": "object",
  "required": ["stages"],
  "additionalProperties": false,
  "properties": {
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["name", "author_skill"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "author_skill": { "type": "string", "minLength": 1 },
        "reviewer_skill": { "type": ["string", "null"], "minLength": 1 },
        "dual_pass_reviewer": { "type": "boolean" },
        "preflight_gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 50 },
        "requires_predecessor": { "type": "string", "minLength": 1 },
        "breakpoint_default": { "type": "boolean" }
      }
    }
  }
}
